+"""
+Live tests against a real Elasticsearch. Skipped unless PROGNOSTIC_TEST_ES_URL is set
+(the retrieval-eval CI job sets it). Dense and hybrid tests also need the embedding model
+(python embeddings.py --download).
+"""
+
+import os
+
+import pytest
+
+from knowledge_base import MAINTENANCE_PROCEDURES
+
+ES_URL = os.getenv("PROGNOSTIC_TEST_ES_URL")
+pytestmark = pytest.mark.skipif(not ES_URL, reason="set PROGNOSTIC_TEST_ES_URL to run")
+
+
+def _embedder_or_skip():
+    try:
+        from embeddings import MiniLMEmbedder
+        return MiniLMEmbedder()
+    except (ImportError, FileNotFoundError) as e:
+        pytest.skip(f"embedding model not available: {e}")
+
+
+def test_bm25_index_and_search():
+    from es_retriever import ElasticsearchRetriever
+    es = ElasticsearchRetriever(url=ES_URL, index="prognosticai-test-bm25", timeout=30)
+    es.ensure_index(MAINTENANCE_PROCEDURES)
+    assert es.ensure_index(MAINTENANCE_PROCEDURES) is False          # second call is a no-op
+    assert es.bm25("ATA 72-30", 5)[0] == "MRO-001"
+    assert es.bm25("spectrometric oil analysis", 5)[0] == "MRO-004"
+    assert "MRO-006" not in es.bm25("imminent failure critical degradation ground aircraft", 10)
+
+
+def test_dense_and_hybrid_search():
+    from es_retriever import ElasticsearchRetriever
+    es = ElasticsearchRetriever(url=ES_URL, index="prognosticai-test-dense",
+                                embedder=_embedder_or_skip(), timeout=30)
+    es.ensure_index(MAINTENANCE_PROCEDURES)
+    dense = es.dense("turbine blades overheating and the ceramic coating is flaking off", 5)
+    assert dense[0] == "MRO-002" and "MRO-006" not in dense and len(dense) == 5
+    assert es.hybrid("metal particles showing up in the lubricant", 2)[0] == "MRO-004"
+
+
+def test_agent_dispatcher_against_live_elasticsearch():
+    from es_retriever import ElasticsearchRetriever
+    from procedure_search import search_procedures
+    es = ElasticsearchRetriever(url=ES_URL, index="prognosticai-test-bm25", timeout=30)
+    es.ensure_index(MAINTENANCE_PROCEDURES)
+    r = search_procedures("Bearing Wear — oil contamination, vibration", 10.0,
+                          backend="elasticsearch", retriever=es, mode="bm25")
+    assert r.backend == "elasticsearch:bm25" and not r.note
+    assert [p.id for p in r.procedures][:2] == ["MRO-006", "MRO-004"]
diff --git a/tests/test_procedure_search.py b/tests/test_procedure_search.py
new file mode 100644
index 0000000..965cade
--- /dev/null
+++ b/tests/test_procedure_search.py
@@ -0,0 +1,237 @@
+"""
+Tests for the optional Elasticsearch retrieval add-on. All offline: Elasticsearch is
+replaced by a fake HTTP session, and the embedder by a fixed-vector stub.
+The live tests are in test_es_integration.py.
+"""
+
+import json
+from dataclasses import replace
+
+import numpy as np
+import pytest
+
+import procedure_search
+import retrieval_eval as RE
+from es_retriever import ElasticsearchRetriever, kb_fingerprint, procedure_text, rrf_fuse
+from knowledge_base import MAINTENANCE_PROCEDURES, retrieve_procedures
+
+QUERIES = [
+    "HPC (High Pressure Compressor) Degradation — blade erosion, tip clearance loss",
+    "Bearing Wear — oil contamination, vibration",
+    "General Engine Degradation",
+    "something with no matching words at all",
+]
+
+
+# ── Fakes ─────────────────────────────────────────────────────────────────
+
+class FakeResponse:
+    def __init__(self, status, payload):
+        self.status_code = status
+        self._payload = payload
+        self.content = json.dumps(payload).encode()
+        self.text = json.dumps(payload)
+
+    def json(self):
+        return self._payload
+
+
+class FakeSession:
+    """Records requests; answers searches with a fixed list of ids."""
+
+    def __init__(self, hit_ids=("MRO-001", "MRO-004"), fingerprint=None):
+        self.calls = []
+        self.hit_ids = list(hit_ids)
+        self.fingerprint = fingerprint
+
+    def request(self, method, url, data=None, headers=None, timeout=None):
+        body = data if (headers or {}).get("Content-Type") == "application/x-ndjson" else (
+            json.loads(data) if data else None)
+        self.calls.append((method, url, body))
+        if url.endswith("/_mapping"):
+            if self.fingerprint is None:
+                return FakeResponse(404, {"error": "index_not_found"})
+            return FakeResponse(200, {"idx": {"mappings": {"_meta": {"kb_fingerprint": self.fingerprint}}}})
+        if url.endswith("/_search"):
+            return FakeResponse(200, {"hits": {"hits": [{"_source": {"id": i}} for i in self.hit_ids]}})
+        if "/_bulk" in url:
+            return FakeResponse(200, {"errors": False})
+        return FakeResponse(200, {"acknowledged": True})
+
+
+class StubEmbedder:
+    dims = 4
+    name = "stub"
+
+    def embed(self, texts):
+        return np.ones((len(texts), 4), dtype=np.float32) / 2.0
+
+    def embed_one(self, text):
+        return [0.5, 0.5, 0.5, 0.5]
+
+
+class FixedRetriever:
+    def __init__(self, ranked):
+        self.ranked = ranked
+
+    def search(self, query, size, mode):
+        return self.ranked
+
+
+# ── Default behaviour is unchanged ────────────────────────────────────────
+
+@pytest.mark.parametrize("query", QUERIES)
+@pytest.mark.parametrize("rul", [5.0, 14.9, 15.0, 80.0])
+def test_default_backend_is_the_original_keyword_retriever(query, rul):
+    result = procedure_search.search_procedures(query, rul)
+    assert result.backend == "keyword"
+    assert [p.id for p in result.procedures] == [p.id for p in retrieve_procedures(query, rul)]
+
+
+def test_unreachable_elasticsearch_falls_back_to_keyword():
